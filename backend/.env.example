PORT=4000
DATABASE_URL=postgresql://username:password@localhost:5432/shph
JWT_SECRET=your_jwt_secret
REDIS_URL=redis://localhost:6379
NODE_ENV=development

# Phone OTP. Use "test" locally and set SMS_TEST_OTP to a fixed 6-digit code.
# Production must use SMS_PROVIDER=twilio and real provider credentials.
SMS_PROVIDER=test
SMS_TEST_OTP=123456
SMS_OTP_TTL_SECONDS=300
SMS_OTP_RESEND_SECONDS=60
SMS_APP_NAME=SerbisyoHub PH
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Alternatively to a Messaging Service SID:
TWILIO_FROM_NUMBER=

# Server-side AI assistant. Never put this key in the Flutter build.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-free
PUBLIC_APP_URL=https://shph.app
