{
    "family": "shph-backend-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "arn:aws:iam::888577050475:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::888577050475:role/ecsTaskRole",
    "containerDefinitions": [
        {
            "name": "shph-backend",
            "image": "888577050475.dkr.ecr.ap-southeast-2.amazonaws.com/shph-backend:latest",
            "portMappings": [
                {
                    "containerPort": 4000,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "PORT",
                    "value": "4000"
                },
                {
                    "name": "DATABASE_URL",
                    "value": "${DATABASE_URL}"
                },
                {
                    "name": "JWT_SECRET",
                    "value": "${JWT_SECRET}"
                },
                {
                    "name": "REDIS_URL",
                    "value": "${REDIS_URL}"
                }
            ],
            "essential": true
        }
    ]
}